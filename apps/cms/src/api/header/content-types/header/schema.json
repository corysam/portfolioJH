{
  "kind": "singleType",
  "collectionName": "headers",
  "info": {
    "singularName": "header",
    "pluralName": "headers",
    "displayName": "1. Header"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "brandName": {
      "type": "string",
      "required": true
    },
    "logo": {
      "pluginOptions": {
        "imageValidation": {
          "rules": [
            {
              "aspectRatio": {
                "width": 1,
                "height": 1
              },
              "minWidth": 256
            }
          ]
        }
      },
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
