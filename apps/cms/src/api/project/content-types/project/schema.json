{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Portfolio project entry"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "blocks"
    },
    "buttonTitle": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "dateAndDuration": {
      "type": "string"
    },
    "mission": {
      "type": "blocks"
    },
    "results": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "projects"
    },
    "software": {
      "type": "component",
      "component": "shared.named-item",
      "repeatable": true
    },
    "clientName": {
      "type": "component",
      "component": "shared.named-item",
      "repeatable": true
    },
    "phases": {
      "type": "component",
      "component": "shared.phase",
      "repeatable": true
    },
    "sections": {
      "type": "component",
      "component": "shared.section",
      "repeatable": true
    },
    "role": {
      "type": "text"
    },
    "Equipe": {
      "type": "string"
    }
  }
}
