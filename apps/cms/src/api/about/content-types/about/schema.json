{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "3. About Me"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "description": {
      "type": "text"
    },
    "tags": {
      "type": "component",
      "component": "shared.tag-label",
      "repeatable": true
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "photo": {
      "pluginOptions": {
        "imageValidation": {
          "rules": [
            {
              "aspectRatio": {
                "width": 4,
                "height": 5
              },
              "minWidth": 1000
            },
            {
              "aspectRatio": {
                "width": 1,
                "height": 1
              },
              "minWidth": 1000
            }
          ]
        }
      },
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "availableForWork": {
      "type": "boolean",
      "default": true
    }
  }
}
