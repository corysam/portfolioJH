{
  "collectionName": "components_shared_sections",
  "info": {
    "displayName": "Section",
    "icon": "layout"
  },
  "options": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "content": { "type": "blocks" },
    "photo": {
      "pluginOptions": {
        "imageValidation": {
          "rules": [
            {
              "aspectRatio": {
                "width": 4,
                "height": 3
              },
              "minWidth": 1200
            }
          ]
        }
      },
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
