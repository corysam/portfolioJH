# Base URL where the site is served (used for sitemap, OpenGraph, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Strapi backend. Leave blank to use built-in mock content for local dev.
STRAPI_URL=https://api.yourdomain.com
# Public mirror — only set if you fetch from Strapi in client components (rare).
NEXT_PUBLIC_STRAPI_URL=https://api.yourdomain.com
# Optional API token for unauthenticated public reads (only needed if you lock down Strapi permissions).
STRAPI_TOKEN=

# Shared secret between Strapi webhook and /api/revalidate.
REVALIDATE_SECRET=change-me

# Resend API key for the contact form. Leave blank to log submissions to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=clement.pellat@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
